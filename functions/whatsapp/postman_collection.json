{
  "info": {
    "name": "OlympiadQuiz - WhatsApp Cloud API",
    "description": "Test collection for the WhatsApp Cloud API module. Set `baseUrl` to your deployed Cloud Functions region+project URL, e.g. https://us-central1-<project-id>.cloudfunctions.net",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://us-central1-<your-project-id>.cloudfunctions.net" },
    { "key": "verifyToken", "value": "<your WHATSAPP_VERIFY_TOKEN value>" },
    { "key": "idToken", "value": "<a Firebase Auth ID token for a logged-in user>" }
  ],
  "item": [
    {
      "name": "Webhook",
      "item": [
        {
          "name": "GET Verify Webhook",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/whatsappWebhook?hub.mode=subscribe&hub.verify_token={{verifyToken}}&hub.challenge=1234567890",
              "host": ["{{baseUrl}}"],
              "path": ["whatsappWebhook"],
              "query": [
                { "key": "hub.mode", "value": "subscribe" },
                { "key": "hub.verify_token", "value": "{{verifyToken}}" },
                { "key": "hub.challenge", "value": "1234567890" }
              ]
            },
            "description": "Should return HTTP 200 with body '1234567890' if WHATSAPP_VERIFY_TOKEN matches."
          }
        },
        {
          "name": "POST Incoming Message (simulated)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "X-Hub-Signature-256",
                "value": "sha256=<compute locally, see description>",
                "description": "Meta signs the raw body with your App Secret: sha256=<hmac_sha256(app_secret, raw_body)>. Without a valid signature this request will be rejected with 401. For local testing, compute it with: node -e \"console.log('sha256='+require('crypto').createHmac('sha256','<WHATSAPP_APP_SECRET>').update(require('fs').readFileSync('body.json')).digest('hex'))\" against the exact raw bytes of the body below."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [\n    {\n      \"id\": \"WABA_ID\",\n      \"changes\": [\n        {\n          \"field\": \"messages\",\n          \"value\": {\n            \"messaging_product\": \"whatsapp\",\n            \"metadata\": { \"display_phone_number\": \"911234567890\", \"phone_number_id\": \"PHONE_NUMBER_ID\" },\n            \"contacts\": [ { \"profile\": { \"name\": \"Test User\" }, \"wa_id\": \"919999999999\" } ],\n            \"messages\": [\n              {\n                \"from\": \"919999999999\",\n                \"id\": \"wamid.TEST123\",\n                \"timestamp\": \"1700000000\",\n                \"text\": { \"body\": \"Hi\" },\n                \"type\": \"text\"\n              }\n            ]\n          }\n        }\n      ]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/whatsappWebhook",
              "host": ["{{baseUrl}}"],
              "path": ["whatsappWebhook"]
            },
            "description": "Simulates Meta delivering an inbound 'Hi' text message. Expect the chatbot to reply with the main menu, and a new document in whatsapp_logs (direction: inbound) plus one in whatsapp_processed_events."
          }
        },
        {
          "name": "POST Status Callback (simulated)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Hub-Signature-256", "value": "sha256=<compute locally, see previous request>" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [\n    {\n      \"id\": \"WABA_ID\",\n      \"changes\": [\n        {\n          \"field\": \"messages\",\n          \"value\": {\n            \"messaging_product\": \"whatsapp\",\n            \"metadata\": { \"display_phone_number\": \"911234567890\", \"phone_number_id\": \"PHONE_NUMBER_ID\" },\n            \"statuses\": [\n              {\n                \"id\": \"wamid.TEST123\",\n                \"status\": \"delivered\",\n                \"timestamp\": \"1700000005\",\n                \"recipient_id\": \"919999999999\"\n              }\n            ]\n          }\n        }\n      ]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/whatsappWebhook",
              "host": ["{{baseUrl}}"],
              "path": ["whatsappWebhook"]
            },
            "description": "Simulates a delivery-status callback. Expect a new document in whatsapp_logs (category: status_update, status: delivered)."
          }
        }
      ]
    },
    {
      "name": "Callable Functions (onCall)",
      "description": "These use the Firebase callable-function HTTPS protocol: POST { \"data\": {...} } and expect Authorization: Bearer <Firebase Auth ID token>. Easiest way to get an ID token for testing: sign in on the site, then in the browser console run `await firebase.auth().currentUser.getIdToken()`.",
      "item": [
        {
          "name": "sendWhatsAppBroadcast (admin only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{idToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"message\": \"Test broadcast from Postman\",\n    \"targetType\": \"All Users\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sendWhatsAppBroadcast",
              "host": ["{{baseUrl}}"],
              "path": ["sendWhatsAppBroadcast"]
            }
          }
        },
        {
          "name": "generateAndSendWhatsAppOtp",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{idToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"phoneNumber\": \"919999999999\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/generateAndSendWhatsAppOtp",
              "host": ["{{baseUrl}}"],
              "path": ["generateAndSendWhatsAppOtp"]
            }
          }
        },
        {
          "name": "verifyWhatsAppOtp",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{idToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"otpId\": \"<otpId returned by generateAndSendWhatsAppOtp>\",\n    \"code\": \"123456\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/verifyWhatsAppOtp",
              "host": ["{{baseUrl}}"],
              "path": ["verifyWhatsAppOtp"]
            }
          }
        }
      ]
    }
  ]
}
