rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to identify the site admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "madhhu52@gmail.com";
    }

    // 1. Questions
    match /questions/{questionId} {
      allow write: if isAdmin();
      allow read: if request.auth != null && (
        !resource.data.keys().hasAny(['testSessionId']) ||
        isAdmin() ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/purchases/$(resource.data.testSessionId))
      );
    }

    // 2. Test Sessions
    match /test_sessions/{sessionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Leaderboard
    match /leaderboard/{entry} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // 4. Feedback (Internal)
    match /feedback/{feedbackId} {
      allow read, write: if isAdmin();
      allow create: if request.auth != null;
    }

    // 5. Feedbacks (User Reports)
    match /feedbacks/{feedbackId} {
      allow create: if request.auth != null;
      allow read, write: if isAdmin();
    }

    // 6. Users
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();

      // Premium-billing fields (isPremium/premiumExpiresAt/razorpaySubscriptionId)
      // can only ever be set by Cloud Functions (Admin SDK bypasses these
      // rules entirely) or the admin - never by the user's own client on
      // either a brand-new doc (create) or an edit to an existing one
      // (update), so a devtools-crafted write can't self-grant Premium.
      // Every other field keeps working exactly as before.
      allow create: if isAdmin() || (
        request.auth != null && request.auth.uid == userId &&
        !request.resource.data.keys().hasAny(['isPremium', 'premiumExpiresAt', 'razorpaySubscriptionId'])
      );
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium', 'premiumExpiresAt', 'razorpaySubscriptionId'])
      );
      allow delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();

      match /purchases/{sessionId} {
        allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      }
    }

    // 7. Study Content
    match /study_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Coupons
    match /coupons/{couponId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 9. Collection Group Queries
    match /{path=**}/purchases/{purchaseId} {
      allow read: if isAdmin();
    }

    // 10. Video Tutorials
    match /video_tutorials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. JEE Mock Tests
    match /jeeMockTests/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 12. Exam Tests (JEE Main, NEET, etc.)
    match /exam_tests/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 13. User Push Notification Tokens
    match /userTokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 14. H.O.T.S Problems
    match /hots_tests/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========================
    // 15. USSC FINANCE FORUM
    // ========================

    // Forum Users
    match /forum_users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Forum Posts
    match /forum_posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.userId || isAdmin());

      // Allows users to click the post Like and Dislike buttons safely
      allow update: if request.auth != null &&
        (
          request.auth.uid == resource.data.userId || isAdmin() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes'])
        );
    }

    // Forum Comments
    match /forum_comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());

      // Allows users to click comment Like/Dislike buttons AND save their names for the tooltip
      allow update: if request.auth != null &&
        (
          request.auth.uid == resource.data.userId || isAdmin() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes', 'likedBy', 'dislikedBy'])
        );
    }

    // Forum Likes
    match /forum_likes/{likeId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
    }
        // Allow public read access to NEET chapters, but only Admin can write
    match /sys_master_chapters/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'madhhu52@gmail.com';
    }

    // Allow public read access to the NEET Question Bank, but only Admin can write
    match /qb_questions/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'madhhu52@gmail.com';
    }


    // ... your existing rules for questions, users, test_sessions, etc.

    match /sof_pyqs/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "madhhu52@gmail.com";
    }

    // Forum Dislikes
    match /forum_dislikes/{dislikeId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // ========================
    // 16. JEE Main PYQs
    // ========================
    match /jeeMainPyqs/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========================
    // 17. Test Attempts (Premium rate-limiting)
    // ========================
    // Server-only. All reads/writes go through the canStartTest /
    // markTestAttemptProgress / completeTestAttempt Cloud Functions (Admin
    // SDK, which always bypasses these rules) - a direct client
    // read/write here is never legitimate, so it's denied outright. This
    // is the security backstop: a client can't forge an attempt or tamper
    // with questionsAnswered/voided to dodge the rate limit.
    match /testAttempts/{attemptId} {
      allow read, write: if false;
    }

    // ========================
    // 18. Payment Failures (Premium webhook visibility log)
    // ========================
    // Server-only, same reasoning as testAttempts above - only
    // razorpayWebhook (Admin SDK) ever writes here.
    match /paymentFailures/{docId} {
      allow read, write: if false;
    }

  }
}
